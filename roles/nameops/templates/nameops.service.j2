[Unit]
Description=NameOps Spring service
Documentation=https://github.com/eicorg/nameops
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ epics_services_account }}
Group={{ epics_services_account }}
WorkingDirectory={{ nameops_install_dir }}
Environment=JAVA_HOME={{ nameops_java_home }}
Environment=PATH={{ nameops_java_home }}/bin:/usr/bin:/usr/local/bin
Environment=NAMEOPS_PORT={{ nameops_http_port }}
ExecStart={{ nameops_java_home }}/bin/java {{ nameops_java_opts }} -jar {{ nameops_jar_dest }} --server.port={{ nameops_http_port }}
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
